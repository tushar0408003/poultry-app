{
  "expo": {
    "name": "KiloKhata",
    "slug": "sales-ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "KiloKhata – Poultry Sales & Khata. Sales by kg. Balances by name.",
    "primaryColor": "#14532D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tusharjakhar.poultryledger"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14532D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tusharjakhar.poultryledger",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#14532D"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "scheme": "salesledger",
    "extra": {
      "eas": {
        "projectId": "0fea3913-e004-497e-8723-3e25f2fec005"
      }
    },
    "owner": "tusharjakhar001"
  }
}
