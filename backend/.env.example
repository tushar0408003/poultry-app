# HTTP port the API listens on
PORT=3000

# MongoDB connection string.
# Transactions need a replica set. A single-node replica set is fine for local use:
#   mongodb://127.0.0.1:27017/supplier_ledger?replicaSet=rs0
# A standalone server also works; the API logs a warning and falls back to
# atomic single-document updates (see README "MongoDB setup").
MONGODB_URI=mongodb://127.0.0.1:27017/supplier_ledger

# JWT signing secret: use a long random string in production
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# The single admin account is created on first start if no user exists.
# Only used when the users collection is empty. Change it later via POST /auth/change-password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123

# Business timezone used to decide what "today" is (IST has no DST).
BUSINESS_TZ_OFFSET_MINUTES=330

# Comma-separated list of allowed CORS origins ("*" for any). Mobile apps do not need CORS.
CORS_ORIGINS=*
